# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# En producción (Render/Railway/HF Spaces) estas variables se configuran en el panel de la plataforma.

# --- Aplicación ---
APP_NAME=Asistente Agrotecnico Cacao
APP_ENV=development
APP_VERSION=0.1.0

# Orígenes permitidos para el frontend (separados por coma)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

# --- Modelo generativo (solo en el backend) ---
GEMINI_API_KEY=
# Confirmar el identificador vigente en la documentación del proveedor antes de usarlo
LLM_MODEL=gemini-flash-latest

# --- RAG (semana 3) ---
VECTORSTORE_DIR=data/vectorstore
