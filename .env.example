# Copie este archivo como .env y ponga SUS claves. El .env NUNCA se sube a GitHub.
# En producción (Azure Container Apps) las claves son SECRETOS de la app (secretref:) y el resto, variables de la app:
# ver docs/despliegue.md. Los valores de abajo son los mismos que usa producción.
# Claves gratuitas: Gemini → https://aistudio.google.com/apikey · Groq → https://console.groq.com/keys

# Proveedor principal y de respaldo (gemini | groq | simulado)
LLM_PRINCIPAL=gemini
LLM_RESPALDO=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Límites de cada llamada
LLM_TIMEOUT_S=8
LLM_MAX_TOKENS=2048
LLM_REINTENTOS=3
# Cuánto «piensa» el modelo antes de responder: low | medium | high
# (en los modelos de razonamiento esto reemplaza a la temperatura)
LLM_RAZONAMIENTO=low

# Preguntas por minuto por IP en /chat (0 = sin límite)
LIMITE_POR_MINUTO=20

# Opcional
APP_VERSION=0.3.0
# LLM_LOG_DIR=logs
