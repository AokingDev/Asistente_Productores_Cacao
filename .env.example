# Copie este archivo como .env y ponga SUS claves. El .env NUNCA se sube a GitHub.
# En la nube (Render/Railway/HF Spaces) estas variables se cargan en el panel de la plataforma.
# Claves gratuitas: Gemini → https://aistudio.google.com/apikey · Groq → https://console.groq.com/keys

# Proveedor principal y de respaldo (gemini | groq | simulado)
LLM_PRINCIPAL=gemini
LLM_RESPALDO=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Límites de cada llamada
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=2048
LLM_REINTENTOS=3
# Cuánto «piensa» el modelo antes de responder: low | medium | high
# (en los modelos de razonamiento esto reemplaza a la temperatura)
LLM_RAZONAMIENTO=low

# Opcional
APP_VERSION=0.2.0
# LLM_LOG_DIR=logs
